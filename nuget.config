<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources of the repository.
  - nuget.org: every package of the solution.
  - superapp-tools: the local folder tools/packages with the developer tool SuperApp.Cli (`dotnet superapp`, ADR-0046), packed there by
    tools/bootstrap.ps1 / tools/bootstrap.sh. Package source mapping takes SuperApp.Cli only from this folder, so a package of the same
    name on nuget.org can never be restored instead (dependency confusion), and no other package is looked up in the folder.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="superapp-tools" value="tools/packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="superapp-tools">
      <package pattern="SuperApp.Cli" />
    </packageSource>
  </packageSourceMapping>
</configuration>
