# Opcjonalnie skopiuj do deploy/local/.env (plik jest w .gitignore), żeby zmienić lokalne hasła (ADR-0034).

# Hasła lokalnej instancji; wyłącznie do developmentu, nigdy na środowiskach współdzielonych.
DB_SA_PASSWORD=Dev!Passw0rd1
DB_APP_PASSWORD=Dev!Passw0rd1

# Hasło pliku deploy/local/certs/devcert.pfx (tworzy go deploy/local/dev-cert.ps1 lub dev-cert.sh).
DEV_CERT_PASSWORD=dev-cert-password

# Analityka produktowa (PostHog Cloud EU, ADR-0036); domyślnie wyłączona. Ustaw obie wartości, żeby wysyłać zdarzenia do własnego,
# deweloperskiego projektu PostHog (nigdy do projektu produkcyjnego). Klucz pseudonimu: dowolny losowy tekst, min. 32 znaki.
# ANALYTICS_PROJECT_TOKEN=phc_...
# ANALYTICS_ID_KEY=...
