<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The OpenAPI 3.0 contract is generated into openapi/ on every build and committed, so contract changes show up in the diff (ADR-0009, ADR-0019). -->
  <PropertyGroup>
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--openapi-version OpenApi3_0</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ServiceName.Application\ServiceName.Application.csproj" />
    <!-- Composition root only: Program.cs registers Infrastructure; no other code may use its types (ADR-0002, architecture test 6). -->
    <ProjectReference Include="..\ServiceName.Infrastructure\ServiceName.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ServiceName.IntegrationTests" />
  </ItemGroup>

</Project>
