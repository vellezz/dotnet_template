<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    BFF of the Example experience (ADR-0038): public API for the module (/v1) and internal API for BFFs of other experiences
    (/internal/v1), both OpenAPI 3.0 contracts generated at build time and committed (ADR-0039). No database, no domain.
  -->
  <PropertyGroup>
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--openapi-version OpenApi3_0</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Framework\SuperApp.Framework.Infrastructure\SuperApp.Framework.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Example.Bff.Tests" />
  </ItemGroup>

</Project>
